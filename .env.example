# Environment variables for the Portainer stack (Stacks > job-ai > Environment variables).
# Portainer's "Load variables from .env file" accepts this file once filled in.
# For local development without Docker, see web/.env.example instead.

# Generate secrets with: openssl rand -base64 32
POSTGRES_PASSWORD=
LOG_LEVEL=info

# Sign-in. BETTER_AUTH_URL is the public address behind the Cloudflare Tunnel; the
# Google OAuth client's redirect URI must be <BETTER_AUTH_URL>/api/auth/callback/google.
BETTER_AUTH_URL=https://jobs.chjrussell.com
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The admin's Google address; made admin on first sign-in.
ADMIN_EMAIL=chjrussell@gmail.com

# Image tag to run; "latest" follows main.
IMAGE_TAG=latest

# The Docker network the cloudflared container is on (docker network ls).
TUNNEL_NETWORK=cloudflared-complete_default

# Vercel AI Gateway key for every model call (shared; the admin pays).
# Create one in the Vercel dashboard under AI Gateway > API Keys.
AI_GATEWAY_API_KEY=

# Nightly backups. Keep the passphrase somewhere other than this server too:
# without it the backups cannot be decrypted.
BACKUP_PASSPHRASE=
# A directory on a different drive from the database.
BACKUP_DIR=/media/cj/14tb/job-ai-backups
BACKUP_TIME=03:00
