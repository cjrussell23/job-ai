# Server-side settings for docker-compose. Copy to .env and fill in.
# For local development without Docker, see web/.env.example instead.

POSTGRES_PASSWORD=change-me
LOG_LEVEL=info

# Sign-in. BETTER_AUTH_URL is the public address behind the Cloudflare Tunnel; the
# Google OAuth client's redirect URI must be <BETTER_AUTH_URL>/api/auth/callback/google.
BETTER_AUTH_URL=https://jobs.example.com
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The admin's Google address; made admin on first sign-in.
ADMIN_EMAIL=

# Image tag to run; "latest" follows main.
IMAGE_TAG=latest
WEB_PORT=3000

# Anthropic API key for every model call (shared; the admin pays).
ANTHROPIC_API_KEY=
