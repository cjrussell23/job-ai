# Local development without Docker. Copy to web/.env.
DATABASE_URL=postgres://localhost:5432/jobai_dev
# Tests truncate tables, so they use their own database.
TEST_DATABASE_URL=postgres://localhost:5432/jobai_test
LOG_LEVEL=debug

# Sign-in. BETTER_AUTH_URL is where the app is reached; the Google OAuth client's
# authorized redirect URI must be <BETTER_AUTH_URL>/api/auth/callback/google.
BETTER_AUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Your own Google address. You are made admin the first time you sign in.
ADMIN_EMAIL=
