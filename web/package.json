{
  "name": "job-ai-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run build:extension && next build",
    "start": "next start",
    "worker": "tsx --conditions=react-server --env-file-if-exists=.env src/worker/index.ts",
    "worker:dev": "tsx watch --conditions=react-server --env-file-if-exists=.env src/worker/index.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "biome check",
    "format": "biome check --write",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --conditions=react-server --env-file-if-exists=.env src/db/migrate.ts",
    "build:extension": "node extension/build.mjs"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.27",
    "ai": "^7.0.179",
    "better-auth": "^1.7.27",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "docx": "9.15.3",
    "drizzle-orm": "^0.45.4",
    "fflate": "0.8.3",
    "lucide-react": "^1.77.0",
    "mammoth": "^1.13.0",
    "next": "16.4.6",
    "node-html-parser": "^9.0.7",
    "pg-boss": "^12.38.2",
    "pino": "^10.4.0",
    "playwright": "^1.65.1",
    "postgres": "^4.1.1",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.0",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "unpdf": "^2.2.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/chrome": "0.3.7",
    "@types/node": "^26.6.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "esbuild": "0.28.2",
    "happy-dom": "21.0.4",
    "pino-pretty": "^13.2.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "^5.1.1"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  },
  "engines": {
    "node": ">=26"
  }
}
